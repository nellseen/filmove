rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly authorize only cristiandwihariantoro@gmail.com with verified email
    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email == 'cristiandwihariantoro@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidPost(data) {
      return data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.sourceUrl is string &&
        data.sourceUrl.size() <= 500 &&
        data.sourceUrl.matches('^https?://(www\\.)?t\\.me/[a-zA-Z0-9_]{3,}/[0-9]+.*$') &&
        data.channelUsername is string &&
        data.channelUsername.size() <= 64 &&
        data.status in ['draft', 'published', 'archived'] &&
        (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000)) &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000));
    }

    // Catalog posts collection
    match /posts/{postId} {
      allow get: if isValidId(postId) && (resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isValidId(postId) && isAdmin() && isValidPost(incoming());
      allow update: if isValidId(postId) && isAdmin() && isValidPost(incoming());
      allow delete: if isValidId(postId) && isAdmin();
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }
  }
}
